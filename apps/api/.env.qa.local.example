# BarberApp API — Local QA bootstrap
# Copy this file to .env.qa.local and fill in the real Clerk user IDs
# for the OWNER and BARBER accounts you use on your local development machine.
#
# This file is LOCAL ONLY and must never be committed.

# Required: real Clerk user IDs for the local QA accounts
QA_OWNER_CLERK_USER_ID=user_OWNER_CLERK_ID
QA_BARBER_CLERK_USER_ID=user_BARBER_CLERK_ID

# Optional: override the local QA row names/emails if you intentionally want
# the bootstrap to store them in your local development database.
# If omitted, existing row values are preserved; fresh rows fall back to the
# committed generic QA identities.
# QA_OWNER_EMAIL=
# QA_OWNER_NAME=
# QA_BARBER_EMAIL=
# QA_BARBER_NAME=

# Optional: override the deterministic local QA barbershop name
# QA_BARBERSHOP_NAME=QA Barbershop

# Advanced escape hatch — leave unset for normal local development.
# When false/unset, QA bootstrap refuses non-loopback database hosts.
# QA_BOOTSTRAP_ALLOW_NONLOCAL_DATABASE=false
