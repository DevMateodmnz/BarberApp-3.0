{
  "name": "@barberapp/api",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "tsx src/testing/groupedVitestRunner.ts unit",
    "test:integration": "tsx src/testing/groupedVitestRunner.ts integration",
    "test:db": "tsx src/testing/groupedVitestRunner.ts db",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:db",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:test": "prisma migrate deploy --schema=./prisma/test.schema.prisma",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "public-slug": "tsx --env-file=.env src/scripts/publicSlug.ts",
    "schedule-exception": "tsx --env-file=.env src/scripts/scheduleException.ts",
    "fixture:public-booking:e2e": "tsx tests/support/publicBookingE2eFixture.cli.ts",
    "qa:bootstrap": "tsx --env-file=.env src/scripts/qaBootstrap.ts",
    "qa:verify": "tsx --env-file=.env src/scripts/qaVerify.ts"
  },
  "dependencies": {
    "@clerk/express": "^1.0.0",
    "@prisma/client": "^5.14.0",
    "cors": "^2.8.5",
    "express": "^4.18.3",
    "express-rate-limit": "^7.2.0",
    "standardwebhooks": "^1.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.0",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^1.4.0",
    "prisma": "^5.14.0",
    "supertest": "^7.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  }
}
