# BarberApp API — production contract (placeholders only; never commit secrets)

# CORE REQUIRED — API and every worker
NODE_ENV=production
DATABASE_URL=postgresql://db_user:db_password@db-host:5432/barberapp
CLERK_SECRET_KEY=sk_live_replace_me
CLERK_WEBHOOK_SECRET=whsec_replace_me

# CORE OPTIONAL
PORT=3000
# CLERK_INVITATION_REDIRECT_URL=https://staff.example.com
# CORS_ALLOWED_ORIGINS=https://admin.example.com
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=100

# NOTIFICATION WORKER REQUIRED (mvp-1.2.0 deploys one notification worker)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=replace_me
SMTP_PASSWORD=replace_me
SMTP_FROM_EMAIL=turnos@example.com
SMTP_FROM_NAME=BarberApp
PUBLIC_WEB_BASE_URL=https://bookings.example.com
# NOTIFICATION_WORKER_BATCH_SIZE=10
# NOTIFICATION_WORKER_POLL_INTERVAL_MS=30000
# NOTIFICATION_STALE_LOCK_MS=600000

# PAYMENTS — mvp-1.2.0 initial deployment must remain false.
PAYMENTS_ENABLED=false

# Required only for a separately approved PAYMENTS_ENABLED=true rollout.
# PAYMENT_CREDENTIAL_ENCRYPTION_KEY=base64_encoded_32_byte_key
# PAYMENT_WEBHOOK_PUBLIC_URL=https://api.example.com/api/v1/webhooks/mercado-pago
# MERCADO_PAGO_CLIENT_ID=replace_me
# MERCADO_PAGO_CLIENT_SECRET=replace_me
# MERCADO_PAGO_REDIRECT_URI=https://api.example.com/api/v1/payments/mercado-pago/oauth/callback
# MERCADO_PAGO_WEBHOOK_SECRET=replace_me
# MERCADO_PAGO_API_BASE_URL=https://api.mercadopago.com
# MERCADO_PAGO_AUTHORIZATION_BASE_URL=https://auth.mercadopago.com
# MERCADO_PAGO_OAUTH_SCOPE=offline_access read write
# PAYMENT_WEBHOOK_WORKER_POLL_INTERVAL_MS=10000
# PAYMENT_EXPIRE_HOLDS_POLL_INTERVAL_MS=30000
