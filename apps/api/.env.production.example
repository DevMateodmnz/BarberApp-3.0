# BarberApp API - Production Environment
# Replace every placeholder before deployment. Do not commit real values.

# Required - production database
DATABASE_URL=postgresql://db_user:db_password@db-host:5432/barberapp

# Required - Clerk backend secrets
CLERK_SECRET_KEY=sk_live_replace_me
CLERK_WEBHOOK_SECRET=whsec_replace_me

# Required - explicit credentialed browser allowlist
# Use a comma-separated list only when more than one origin is intentional.
ALLOWED_ORIGIN=https://app.example.com
# ALLOWED_ORIGIN=https://app.example.com,https://admin.example.com

# Optional - server/runtime
PORT=3000
NODE_ENV=production

# Optional - rate limiting overrides
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=100
