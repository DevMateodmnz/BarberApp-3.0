// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  OWNER
  BARBER
  CLIENT
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum DepositPolicyMode {
  DISABLED
  FIXED
  PERCENTAGE
}

enum PaymentProvider {
  MERCADO_PAGO
}

enum PaymentConnectionStatus {
  DISCONNECTED
  CONNECTING
  CONNECTED
  REFRESH_REQUIRED
  REVOKED
  ERROR
}

enum BookingPaymentPurpose {
  DEPOSIT
}

enum BookingPaymentStatus {
  CREATING
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
  REFUNDED
  REVIEW_REQUIRED
  ERROR
}

enum PaymentReviewStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum PaymentReviewReason {
  APPROVED_AFTER_HOLD_EXPIRY
  APPROVED_PAYMENT_ON_CANCELLED_APPOINTMENT
  AMOUNT_MISMATCH
  CURRENCY_MISMATCH
  SELLER_MISMATCH
  EXTERNAL_REFERENCE_MISMATCH
  PREFERENCE_MISMATCH
  DUPLICATE_PROVIDER_PAYMENT
  PROVIDER_RECONCILIATION_ERROR
  OTHER
}

enum PaymentReviewResolution {
  REFUNDED_EXTERNALLY
  NO_REFUND_REQUIRED
  CUSTOMER_CREDIT_GRANTED
  PAYMENT_ACCEPTED_MANUALLY
  DUPLICATE_RESOLVED
  OTHER
}

enum PaymentReviewActionType {
  OPENED
  MARKED_IN_PROGRESS
  NOTE_ADDED
  RESOLVED
  REOPENED
}

enum PaymentWebhookEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  REJECTED
  ERROR
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  OTHER
}

enum EmployeeInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
  DELIVERY_FAILED
}

enum EmployeeScheduleMode {
  INHERIT_BARBERSHOP
  CUSTOM
}

enum EmployeeScheduleExceptionType {
  FULL_DAY_OFF
  CUSTOM_HOURS
}

// Where a cancellation originated. Decoupled from UserRole because
// anonymous public bookings and automated (system) jobs have no
// UserRole identity. A row that was cancelled has at least one of
// (cancelledByRole, cancellationSource) populated, never both null.
enum AppointmentCancellationSource {
  STAFF
  AUTHENTICATED_CLIENT
  PUBLIC_BOOKING
  SYSTEM
}

enum AppointmentNotificationType {
  BOOKING_CONFIRMATION
  REMINDER_24H
  APPOINTMENT_RESCHEDULED
}

enum AppointmentChangeType {
  RESCHEDULED
}

enum AppointmentNotificationChannel {
  EMAIL
}

enum AppointmentNotificationStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

enum NotificationAttemptOutcome {
  SENT
  TEMPORARY_FAILURE
  PERMANENT_FAILURE
}

// ============================================
// USER
// ============================================

/// User model - represents all authenticated users (owners, barbers, clients)
/// Each user is tied to a Clerk user via clerkUserId
model User {
  id          String    @id @default(cuid())
  clerkUserId String    @unique @map("clerk_user_id")
  email       String    @unique
  name        String?
  role        UserRole  @default(CLIENT)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  // Relations
  ownedBarbershops                      Barbershop[]              @relation("BarbershopOwner")
  employees                             Employee[]
  clientAppointments                    Appointment[]             @relation("AppointmentClient")
  appointmentChanges                    AppointmentChange[]       @relation("AppointmentChangeActor")
  uploadedPhotos                        Photo[]                   @relation("PhotoUploader")
  clientPhotos                          Photo[]                   @relation("PhotoClient")
  sentInvitations                       EmployeeInvitation[]      @relation("EmployeeInvitationInvitedBy")
  acceptedInvitations                   EmployeeInvitation[]      @relation("EmployeeInvitationUser")
  manualRetriedAppointmentNotifications AppointmentNotification[] @relation("AppointmentNotificationLastManualRetryBy")
  PaymentOAuthState                     PaymentOAuthState[]
  assignedPaymentReviews                BookingPaymentReview[]    @relation("BookingPaymentReviewAssignedTo")
  resolvedPaymentReviews                BookingPaymentReview[]    @relation("BookingPaymentReviewResolvedBy")
  paymentReviewActions                  BookingPaymentReviewAction[] @relation("BookingPaymentReviewActionActor")

  @@map("users")
}

// ============================================
// BARBERSHOP
// ============================================

/// Barbershop model - represents a barbershop business
/// Each barbershop has exactly one owner
model Barbershop {
  id         String    @id @default(cuid())
  ownerId    String    @map("owner_id")
  name       String
  address    String?
  phone      String?
  publicSlug String?   @unique @map("public_slug")
  timezone   String    @default("America/Argentina/Tucuman")
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  // Relations
  owner                           User                             @relation("BarbershopOwner", fields: [ownerId], references: [id])
  employees                       Employee[]
  services                        Service[]
  appointments                    Appointment[]
  customers                       Customer[]
  workingHours                    WorkingHours[]
  scheduleExceptions              BarbershopScheduleException[]
  employeeWorkingIntervals        EmployeeWorkingInterval[]
  employeeScheduleExceptions      EmployeeScheduleException[]
  publicBookingIdempotencyRecords PublicBookingIdempotency[]
  appointmentNotifications        AppointmentNotification[]
  appointmentNotificationAttempts AppointmentNotificationAttempt[]
  appointmentChanges              AppointmentChange[]
  serviceRecords                  ServiceRecord[]
  employeeInvitations             EmployeeInvitation[]
  depositPolicy                   BarbershopDepositPolicy?
  paymentConnections              BarbershopPaymentConnection[]
  paymentWebhookEvents            PaymentWebhookEvent[]
  bookingPayments                 BookingPayment[]
  PaymentOAuthState               PaymentOAuthState[]
  paymentReviews                  BookingPaymentReview[]
  paymentReviewActions            BookingPaymentReviewAction[]

  // Indexes
  @@index([ownerId])
  @@index([ownerId, isActive])
  @@map("barbershops")
}

// ============================================
// EMPLOYEE
// ============================================

/// Employee model - represents a barber/employee working at a barbershop
/// Links a User to a Barbershop
model Employee {
  id           String               @id @default(cuid())
  barbershopId String               @map("barbershop_id")
  userId       String               @map("user_id")
  isActive     Boolean              @default(true)
  scheduleMode EmployeeScheduleMode @default(INHERIT_BARBERSHOP) @map("schedule_mode")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  deletedAt    DateTime?            @map("deleted_at")

  // Relations
  barbershop          Barbershop                  @relation(fields: [barbershopId], references: [id])
  user                User                        @relation(fields: [userId], references: [id])
  employeeServices    EmployeeService[]
  appointments        Appointment[]
  serviceRecords      ServiceRecord[]
  workingIntervals    EmployeeWorkingInterval[]
  scheduleExceptions  EmployeeScheduleException[]
  acceptedInvitations EmployeeInvitation[]        @relation("EmployeeInvitationEmployee")

  // Constraint: one employee record per user per barbershop
  @@unique([barbershopId, userId])
  @@unique([id, barbershopId])
  // Indexes
  @@index([barbershopId])
  @@index([userId])
  @@index([barbershopId, isActive])
  @@map("employees")
}

// ============================================
// EMPLOYEE SCHEDULE
// ============================================

/// EmployeeWorkingInterval model — one recurring custom interval per employee/day.
/// Current product scope supports at most one interval per weekday for custom employee schedules.
model EmployeeWorkingInterval {
  id           String   @id @default(cuid())
  barbershopId String   @map("barbershop_id")
  employeeId   String   @map("employee_id")
  dayOfWeek    Int      @map("day_of_week")
  openTime     String   @map("open_time")
  closeTime    String   @map("close_time")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  employee   Employee   @relation(fields: [employeeId, barbershopId], references: [id, barbershopId], onDelete: Cascade)
  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@unique([employeeId, dayOfWeek])
  @@index([employeeId])
  @@index([barbershopId, dayOfWeek])
  @@map("employee_working_intervals")
}

/// EmployeeScheduleException model — employee-specific local-date override.
model EmployeeScheduleException {
  id           String                        @id @default(cuid())
  barbershopId String                        @map("barbershop_id")
  employeeId   String                        @map("employee_id")
  localDate    String                        @map("local_date")
  type         EmployeeScheduleExceptionType
  reason       String?                       @db.VarChar(500)
  createdAt    DateTime                      @default(now()) @map("created_at")
  updatedAt    DateTime                      @updatedAt @map("updated_at")

  employee   Employee                            @relation(fields: [employeeId, barbershopId], references: [id, barbershopId], onDelete: Cascade)
  barbershop Barbershop                          @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  intervals  EmployeeScheduleExceptionInterval[]

  @@unique([employeeId, localDate])
  @@index([employeeId, localDate])
  @@index([barbershopId, localDate])
  @@map("employee_schedule_exceptions")
}

/// EmployeeScheduleExceptionInterval model — ordered custom intervals for one employee exception date.
model EmployeeScheduleExceptionInterval {
  id                  String   @id @default(cuid())
  scheduleExceptionId String   @map("schedule_exception_id")
  openTime            String   @map("open_time")
  closeTime           String   @map("close_time")
  position            Int
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  scheduleException EmployeeScheduleException @relation(fields: [scheduleExceptionId], references: [id], onDelete: Cascade)

  @@unique([scheduleExceptionId, position])
  @@index([scheduleExceptionId])
  @@map("employee_schedule_exception_intervals")
}

// ============================================
// EMPLOYEE INVITATION
// ============================================

/// EmployeeInvitation model - tracks the invitation lifecycle for BARBER onboarding
model EmployeeInvitation {
  id                  String                   @id @default(cuid())
  barbershopId        String                   @map("barbershop_id")
  invitedByUserId     String                   @map("invited_by_user_id")
  emailNormalized     String                   @map("email_normalized")
  invitedRole         UserRole                 @default(BARBER) @map("invited_role")
  status              EmployeeInvitationStatus @default(PENDING)
  clerkInvitationId   String?                  @unique @map("clerk_invitation_id")
  expiresAt           DateTime?                @map("expires_at")
  lastSentAt          DateTime?                @map("last_sent_at")
  resendCount         Int                      @default(0) @map("resend_count")
  deliveryFailureCode String?                  @map("delivery_failure_code")
  acceptedAt          DateTime?                @map("accepted_at")
  revokedAt           DateTime?                @map("revoked_at")
  userId              String?                  @map("user_id")
  employeeId          String?                  @map("employee_id")
  createdAt           DateTime                 @default(now()) @map("created_at")
  updatedAt           DateTime                 @updatedAt @map("updated_at")

  // Relations
  barbershop    Barbershop @relation(fields: [barbershopId], references: [id])
  invitedByUser User       @relation("EmployeeInvitationInvitedBy", fields: [invitedByUserId], references: [id])
  user          User?      @relation("EmployeeInvitationUser", fields: [userId], references: [id], onDelete: SetNull)
  employee      Employee?  @relation("EmployeeInvitationEmployee", fields: [employeeId], references: [id], onDelete: SetNull)

  @@unique([barbershopId, emailNormalized])
  @@index([barbershopId])
  @@index([invitedByUserId])
  @@index([userId])
  @@index([employeeId])
  @@index([barbershopId, status])
  @@map("employee_invitations")
}

// ============================================
// SERVICE
// ============================================

/// Service model - represents a service offered by a barbershop
model Service {
  id              String    @id @default(cuid())
  barbershopId    String    @map("barbershop_id")
  name            String
  description     String?
  durationMinutes Int       @map("duration_minutes")
  priceCents      Int       @map("price_cents")
  currency        String    @default("ARS")
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  // Relations
  barbershop       Barbershop        @relation(fields: [barbershopId], references: [id])
  employeeServices EmployeeService[]
  appointments     Appointment[]
  serviceRecords   ServiceRecord[]

  // Indexes
  @@index([barbershopId])
  @@index([barbershopId, isActive])
  @@map("services")
}

// ============================================
// EMPLOYEE_SERVICE
// ============================================

/// EmployeeService model - junction table linking employees to services they can perform
model EmployeeService {
  id         String   @id @default(cuid())
  employeeId String   @map("employee_id")
  serviceId  String   @map("service_id")
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  employee Employee @relation(fields: [employeeId], references: [id])
  service  Service  @relation(fields: [serviceId], references: [id])

  // Constraint: unique employee + service pair
  @@unique([employeeId, serviceId])
  @@index([employeeId])
  @@index([serviceId])
  @@map("employee_services")
}

// ============================================
// APPOINTMENT
// ============================================

/// Appointment model - represents a booked appointment
model Appointment {
  id                      String                         @id @default(cuid())
  barbershopId            String                         @map("barbershop_id")
  employeeId              String                         @map("employee_id")
  clientId                String?                        @map("client_id")
  serviceId               String                         @map("service_id")
  clientName              String                         @map("client_name")
  clientPhone             String?                        @map("client_phone")
  clientEmail             String?                        @map("client_email")
  customerId              String?                        @map("customer_id")
  publicReference         String?                        @unique @map("public_reference")
  publicConsentAcceptedAt DateTime?                      @map("public_consent_accepted_at")
  publicConsentVersion    String?                        @map("public_consent_version")
  serviceName             String                         @map("service_name")
  servicePriceCents       Int                            @map("service_price_cents")
  serviceDurationMinutes  Int                            @map("service_duration_minutes")
  serviceCurrency         String                         @map("service_currency")
  startAt                 DateTime                       @map("start_at")
  endAt                   DateTime                       @map("end_at")
  status                  AppointmentStatus              @default(PENDING)
  paymentHoldExpiresAt    DateTime?                      @map("payment_hold_expires_at")
  paymentConfirmedAt      DateTime?                      @map("payment_confirmed_at")
  notes                   String?
  // Lifecycle tracking — Phase 1 no-show prevention foundation.
  // All fields are nullable so existing rows remain valid and the migration
  // is purely additive. Timestamps are stamped in the barbershop's UTC instant
  // by the service layer; cancelledByRole records the role of the actor.
  startedAt               DateTime?                      @map("started_at")
  confirmedAt             DateTime?                      @map("confirmed_at")
  completedAt             DateTime?                      @map("completed_at")
  cancelledAt             DateTime?                      @map("cancelled_at")
  noShowAt                DateTime?                      @map("no_show_at")
  cancelledByRole         UserRole?                      @map("cancelled_by_role")
  cancellationSource      AppointmentCancellationSource? @map("cancellation_source")
  cancelReason            String?                        @map("cancel_reason") @db.VarChar(500)
  // Normalized E.164 client phone, populated by the service for new
  // bookings. Legacy rows remain NULL; the customer lookup endpoint
  // only matches when the normalized value is present.
  clientPhoneNormalized   String?                        @map("client_phone_normalized") @db.VarChar(20)
  createdAt               DateTime                       @default(now()) @map("created_at")
  updatedAt               DateTime                       @updatedAt @map("updated_at")
  deletedAt               DateTime?                      @map("deleted_at")

  // Relations
  barbershop                      Barbershop                 @relation(fields: [barbershopId], references: [id])
  employee                        Employee                   @relation(fields: [employeeId], references: [id])
  client                          User?                      @relation("AppointmentClient", fields: [clientId], references: [id])
  customer                        Customer?                  @relation("AppointmentCustomer", fields: [customerId, barbershopId], references: [id, barbershopId], onDelete: Restrict)
  service                         Service                    @relation(fields: [serviceId], references: [id])
  publicBookingIdempotencyRecords PublicBookingIdempotency[]
  notifications                   AppointmentNotification[]
  changes                         AppointmentChange[]
  serviceRecords                  ServiceRecord[]
  bookingPayments                 BookingPayment[]

  @@unique([id, barbershopId])
  // Indexes for common queries
  @@index([barbershopId])
  @@index([employeeId])
  @@index([clientId])
  @@index([customerId])
  @@index([customerId, barbershopId])
  @@index([startAt])
  @@index([barbershopId, employeeId, startAt])
  @@index([employeeId, startAt, status])
  @@index([barbershopId, clientPhoneNormalized])
  @@index([paymentHoldExpiresAt])
  @@map("appointments")
}

model BarbershopDepositPolicy {
  id                    String            @id @default(cuid())
  barbershopId          String            @unique @map("barbershop_id")
  mode                  DepositPolicyMode @default(DISABLED)
  fixedAmountCents      Int?              @map("fixed_amount_cents")
  percentageBasisPoints Int?              @map("percentage_basis_points")
  holdDurationMinutes   Int               @default(15) @map("hold_duration_minutes")
  currency              String            @default("ARS")
  publicTerms           String?           @map("public_terms") @db.VarChar(1000)
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")

  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@map("barbershop_deposit_policies")
}

model BarbershopPaymentConnection {
  id                     String                  @id @default(cuid())
  barbershopId           String                  @map("barbershop_id")
  provider               PaymentProvider
  status                 PaymentConnectionStatus @default(DISCONNECTED)
  providerSellerId       String?                 @map("provider_seller_id")
  providerPublicKey      String?                 @map("provider_public_key")
  accessTokenCiphertext  String?                 @map("access_token_ciphertext") @db.Text
  refreshTokenCiphertext String?                 @map("refresh_token_ciphertext") @db.Text
  tokenExpiresAt         DateTime?               @map("token_expires_at")
  scopes                 String?                 @db.VarChar(1000)
  connectedAt            DateTime?               @map("connected_at")
  lastRefreshedAt        DateTime?               @map("last_refreshed_at")
  revokedAt              DateTime?               @map("revoked_at")
  lastErrorCode          String?                 @map("last_error_code") @db.VarChar(120)
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")

  barbershop      Barbershop            @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  oauthStates     PaymentOAuthState[]
  bookingPayments BookingPayment[]
  webhookEvents   PaymentWebhookEvent[]

  @@unique([barbershopId, provider])
  @@index([barbershopId, status])
  @@map("barbershop_payment_connections")
}

model PaymentOAuthState {
  id                     String          @id @default(cuid())
  barbershopId           String          @map("barbershop_id")
  initiatedByUserId      String          @map("initiated_by_user_id")
  provider               PaymentProvider
  stateHash              String          @unique @map("state_hash")
  pkceVerifierCiphertext String          @map("pkce_verifier_ciphertext") @db.Text
  redirectTarget         String?         @map("redirect_target") @db.VarChar(500)
  expiresAt              DateTime        @map("expires_at")
  consumedAt             DateTime?       @map("consumed_at")
  createdAt              DateTime        @default(now()) @map("created_at")
  updatedAt              DateTime        @updatedAt @map("updated_at")

  barbershop      Barbershop                   @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  initiatedByUser User                         @relation(fields: [initiatedByUserId], references: [id], onDelete: Cascade)
  connection      BarbershopPaymentConnection? @relation(fields: [barbershopId, provider], references: [barbershopId, provider], onDelete: Cascade)

  @@index([barbershopId, provider, expiresAt])
  @@map("payment_oauth_states")
}

model BookingPayment {
  id                    String                @id @default(cuid())
  barbershopId          String                @map("barbershop_id")
  appointmentId         String                @map("appointment_id")
  paymentConnectionId   String?               @map("payment_connection_id")
  provider              PaymentProvider
  purpose               BookingPaymentPurpose
  status                BookingPaymentStatus  @default(CREATING)
  amountCents           Int                   @map("amount_cents")
  currency              String
  policyModeSnapshot    DepositPolicyMode     @map("policy_mode_snapshot")
  policyValueSnapshot   Int                   @map("policy_value_snapshot")
  externalReference     String                @unique @map("external_reference")
  providerPreferenceId  String?               @map("provider_preference_id")
  providerPaymentId     String?               @unique @map("provider_payment_id")
  checkoutUrlCiphertext String?               @map("checkout_url_ciphertext") @db.Text
  expiresAt             DateTime              @map("expires_at")
  approvedAt            DateTime?             @map("approved_at")
  rejectedAt            DateTime?             @map("rejected_at")
  cancelledAt           DateTime?             @map("cancelled_at")
  expiredAt             DateTime?             @map("expired_at")
  reviewRequiredAt      DateTime?             @map("review_required_at")
  reviewReasonCode      String?               @map("review_reason_code") @db.VarChar(120)
  providerStatus        String?               @map("provider_status") @db.VarChar(120)
  providerStatusDetail  String?               @map("provider_status_detail") @db.VarChar(255)
  lastErrorCode         String?               @map("last_error_code") @db.VarChar(120)
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  appointment       Appointment                  @relation(fields: [appointmentId, barbershopId], references: [id, barbershopId], onDelete: Restrict)
  barbershop        Barbershop                   @relation(fields: [barbershopId], references: [id], onDelete: Restrict)
  paymentConnection BarbershopPaymentConnection? @relation(fields: [paymentConnectionId], references: [id], onDelete: SetNull)
  webhookEvents     PaymentWebhookEvent[]
  reviews           BookingPaymentReview[]

  @@index([status, expiresAt])
  @@index([barbershopId, createdAt])
  @@index([appointmentId, status])
  @@map("booking_payments")
}

model PaymentWebhookEvent {
  id                  String                    @id @default(cuid())
  barbershopId        String?                   @map("barbershop_id")
  paymentConnectionId String?                   @map("payment_connection_id")
  bookingPaymentId    String?                   @map("booking_payment_id")
  provider            PaymentProvider
  status              PaymentWebhookEventStatus @default(RECEIVED)
  eventTopic          String?                   @map("event_topic") @db.VarChar(120)
  eventAction         String?                   @map("event_action") @db.VarChar(120)
  dataId              String                    @map("data_id")
  externalReference   String?                   @map("external_reference") @db.VarChar(120)
  requestId           String?                   @map("request_id") @db.VarChar(120)
  signatureTs         String?                   @map("signature_ts") @db.VarChar(120)
  rawBodySha256       String                    @map("raw_body_sha256") @db.VarChar(64)
  attemptCount        Int                       @default(1) @map("attempt_count")
  processedAt         DateTime?                 @map("processed_at")
  lastErrorCode       String?                   @map("last_error_code") @db.VarChar(120)
  createdAt           DateTime                  @default(now()) @map("created_at")
  updatedAt           DateTime                  @updatedAt @map("updated_at")

  barbershop        Barbershop?                  @relation(fields: [barbershopId], references: [id], onDelete: SetNull)
  paymentConnection BarbershopPaymentConnection? @relation(fields: [paymentConnectionId], references: [id], onDelete: SetNull)
  bookingPayment    BookingPayment?              @relation(fields: [bookingPaymentId], references: [id], onDelete: SetNull)

  @@unique([provider, dataId, externalReference], map: "payment_webhook_event_provider_data_reference_key")
  @@index([status, createdAt])
  @@map("payment_webhook_events")
}

model BookingPaymentReview {
  id               String                  @id @default(cuid())
  barbershopId     String                  @map("barbershop_id")
  bookingPaymentId String                  @map("booking_payment_id")
  reason           PaymentReviewReason
  status           PaymentReviewStatus     @default(OPEN)
  resolution       PaymentReviewResolution?
  openedAt         DateTime                @default(now()) @map("opened_at")
  startedAt        DateTime?               @map("started_at")
  resolvedAt       DateTime?               @map("resolved_at")
  assignedToUserId String?                 @map("assigned_to_user_id")
  resolvedByUserId String?                 @map("resolved_by_user_id")
  latestNote       String?                 @map("latest_note") @db.VarChar(1000)
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")

  barbershop      Barbershop                  @relation(fields: [barbershopId], references: [id], onDelete: Restrict)
  bookingPayment  BookingPayment              @relation(fields: [bookingPaymentId], references: [id], onDelete: Restrict)
  assignedToUser  User?                       @relation("BookingPaymentReviewAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  resolvedByUser  User?                       @relation("BookingPaymentReviewResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  actions         BookingPaymentReviewAction[]

  @@unique([bookingPaymentId, reason])
  @@index([barbershopId, status, openedAt])
  @@map("booking_payment_reviews")
}

model BookingPaymentReviewAction {
  id           String                  @id @default(cuid())
  barbershopId String                  @map("barbershop_id")
  reviewId     String                  @map("review_id")
  action       PaymentReviewActionType
  actorUserId  String?                 @map("actor_user_id")
  actorRole    UserRole?               @map("actor_role")
  note         String?                 @db.VarChar(1000)
  resolution   PaymentReviewResolution?
  createdAt    DateTime                @default(now()) @map("created_at")

  barbershop Barbershop           @relation(fields: [barbershopId], references: [id], onDelete: Restrict)
  review     BookingPaymentReview @relation(fields: [reviewId], references: [id], onDelete: Restrict)
  actorUser  User?                @relation("BookingPaymentReviewActionActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([reviewId, createdAt])
  @@index([barbershopId, createdAt])
  @@map("booking_payment_review_actions")
}

model AppointmentNotification {
  id                      String                         @id @default(cuid())
  barbershopId            String                         @map("barbershop_id")
  appointmentId           String                         @map("appointment_id")
  type                    AppointmentNotificationType
  channel                 AppointmentNotificationChannel
  status                  AppointmentNotificationStatus  @default(PENDING)
  recipientEmail          String                         @map("recipient_email")
  scheduledFor            DateTime                       @map("scheduled_for")
  nextAttemptAt           DateTime                       @map("next_attempt_at")
  attempts                Int                            @default(0)
  manualRetryCount        Int                            @default(0) @map("manual_retry_count")
  lastManualRetryAt       DateTime?                      @map("last_manual_retry_at")
  lastManualRetryByUserId String?                        @map("last_manual_retry_by_user_id")
  lockToken               String?                        @map("lock_token")
  lockedAt                DateTime?                      @map("locked_at")
  lastError               String?                        @map("last_error") @db.VarChar(1000)
  sentAt                  DateTime?                      @map("sent_at")
  cancelledAt             DateTime?                      @map("cancelled_at")
  providerMessageId       String?                        @map("provider_message_id")
  idempotencyKey          String                         @unique @map("idempotency_key")
  payload                 Json
  createdAt               DateTime                       @default(now()) @map("created_at")
  updatedAt               DateTime                       @updatedAt @map("updated_at")

  appointment           Appointment                      @relation(fields: [appointmentId, barbershopId], references: [id, barbershopId], onDelete: Restrict)
  barbershop            Barbershop                       @relation(fields: [barbershopId], references: [id], onDelete: Restrict)
  lastManualRetryByUser User?                            @relation("AppointmentNotificationLastManualRetryBy", fields: [lastManualRetryByUserId], references: [id], onDelete: SetNull)
  deliveryAttempts      AppointmentNotificationAttempt[]

  @@unique([id, barbershopId])
  @@index([status, nextAttemptAt])
  @@index([appointmentId, status])
  @@index([barbershopId, createdAt])
  @@map("appointment_notifications")
}

model AppointmentChange {
  id                   String                @id @default(cuid())
  barbershopId         String                @map("barbershop_id")
  appointmentId        String                @map("appointment_id")
  type                 AppointmentChangeType
  changedByUserId      String                @map("changed_by_user_id")
  changedByRole        UserRole              @map("changed_by_role")
  previousEmployeeId   String                @map("previous_employee_id")
  previousEmployeeName String                @map("previous_employee_name")
  previousServiceId    String                @map("previous_service_id")
  previousServiceName  String                @map("previous_service_name")
  previousStartAt      DateTime              @map("previous_start_at")
  previousEndAt        DateTime              @map("previous_end_at")
  newEmployeeId        String                @map("new_employee_id")
  newEmployeeName      String                @map("new_employee_name")
  newServiceId         String                @map("new_service_id")
  newServiceName       String                @map("new_service_name")
  newStartAt           DateTime              @map("new_start_at")
  newEndAt             DateTime              @map("new_end_at")
  reason               String?               @db.VarChar(500)
  createdAt            DateTime              @default(now()) @map("created_at")

  appointment   Appointment @relation(fields: [appointmentId, barbershopId], references: [id, barbershopId], onDelete: Restrict)
  barbershop    Barbershop  @relation(fields: [barbershopId], references: [id], onDelete: Restrict)
  changedByUser User        @relation("AppointmentChangeActor", fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@index([appointmentId, createdAt])
  @@index([barbershopId, createdAt])
  @@index([changedByUserId])
  @@map("appointment_changes")
}

model AppointmentNotificationAttempt {
  id                        String                     @id @default(cuid())
  barbershopId              String                     @map("barbershop_id")
  appointmentNotificationId String                     @map("appointment_notification_id")
  attemptNumber             Int                        @map("attempt_number")
  outcome                   NotificationAttemptOutcome
  attemptedAt               DateTime                   @default(now()) @map("attempted_at")
  completedAt               DateTime?                  @map("completed_at")
  workerTokenHash           String?                    @map("worker_token_hash")
  providerMessageIdHash     String?                    @map("provider_message_id_hash")
  errorCode                 String?                    @map("error_code")
  sanitizedError            String?                    @map("sanitized_error") @db.VarChar(1000)
  durationMs                Int?                       @map("duration_ms")
  createdAt                 DateTime                   @default(now()) @map("created_at")

  notification AppointmentNotification @relation(fields: [appointmentNotificationId, barbershopId], references: [id, barbershopId], onDelete: Restrict)
  barbershop   Barbershop              @relation(fields: [barbershopId], references: [id], onDelete: Restrict)

  @@unique([appointmentNotificationId, attemptNumber], map: "appt_notif_attempts_notif_attempt_num_key")
  @@index([appointmentNotificationId, attemptedAt], map: "appt_notif_attempts_notif_attempted_idx")
  @@index([barbershopId, attemptedAt], map: "appt_notif_attempts_shop_attempted_idx")
  @@map("appointment_notification_attempts")
}

model PublicBookingIdempotency {
  id                 String   @id @default(cuid())
  barbershopId       String   @map("barbershop_id")
  operation          String
  idempotencyKey     String   @map("idempotency_key")
  requestFingerprint String   @map("request_fingerprint")
  appointmentId      String?  @map("appointment_id")
  expiresAt          DateTime @map("expires_at")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  barbershop  Barbershop   @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@unique([barbershopId, operation, idempotencyKey])
  @@index([barbershopId])
  @@index([appointmentId])
  @@index([expiresAt])
  @@map("public_booking_idempotency")
}

// ============================================
// SERVICE RECORD
// ============================================

/// ServiceRecord model - represents a completed service/cut performed by a barber
/// Supports walk-in customers (no appointment required) and future appointment-linked records
model ServiceRecord {
  id            String         @id @default(cuid())
  barbershopId  String         @map("barbershop_id")
  employeeId    String         @map("employee_id")
  serviceId     String         @map("service_id")
  appointmentId String?        @map("appointment_id")
  clientName    String?        @map("client_name")
  priceCents    Int            @map("price_cents")
  paymentMethod PaymentMethod? @map("payment_method")
  notes         String?
  performedAt   DateTime       @default(now()) @map("performed_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  deletedAt     DateTime?      @map("deleted_at")

  // Relations
  barbershop  Barbershop   @relation(fields: [barbershopId], references: [id])
  employee    Employee     @relation(fields: [employeeId], references: [id])
  service     Service      @relation(fields: [serviceId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])

  // Indexes
  @@index([barbershopId])
  @@index([employeeId])
  @@index([serviceId])
  @@index([barbershopId, performedAt])
  @@index([employeeId, performedAt])
  @@map("service_records")
}

// ============================================
// WORKING HOURS
// ============================================

/// WorkingHours model — per-barbershop per-day-of-week schedule
/// dayOfWeek: 0=Sunday, 1=Monday, ..., 6=Saturday
/// openTime/closeTime in "HH:mm" 24h format in the barbershop's local timezone
/// Absence of a row for a given dayOfWeek means the shop is closed that day
model WorkingHours {
  id           String   @id @default(cuid())
  barbershopId String   @map("barbershop_id")
  dayOfWeek    Int      @map("day_of_week")
  openTime     String   @map("open_time")
  closeTime    String   @map("close_time")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  barbershop Barbershop @relation(fields: [barbershopId], references: [id])

  // Constraint: one schedule per barbershop per day
  @@unique([barbershopId, dayOfWeek])
  @@index([barbershopId])
  @@map("working_hours")
}

// ============================================
// BARBERSHOP SCHEDULE EXCEPTIONS
// ============================================

/// BarbershopScheduleException model — date-specific weekly-hours override
/// localDate is stored as a strict YYYY-MM-DD string in the barbershop's local timezone
model BarbershopScheduleException {
  id           String   @id @default(cuid())
  barbershopId String   @map("barbershop_id")
  localDate    String   @map("local_date")
  isClosed     Boolean  @default(false) @map("is_closed")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  barbershop Barbershop                            @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  intervals  BarbershopScheduleExceptionInterval[]

  @@unique([barbershopId, localDate])
  @@index([barbershopId])
  @@map("barbershop_schedule_exceptions")
}

/// BarbershopScheduleExceptionInterval model — ordered custom intervals for one exception date
model BarbershopScheduleExceptionInterval {
  id                  String   @id @default(cuid())
  scheduleExceptionId String   @map("schedule_exception_id")
  openTime            String   @map("open_time")
  closeTime           String   @map("close_time")
  position            Int
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  // Relations
  scheduleException BarbershopScheduleException @relation(fields: [scheduleExceptionId], references: [id], onDelete: Cascade)

  @@unique([scheduleExceptionId, position])
  @@index([scheduleExceptionId])
  @@map("barbershop_schedule_exception_intervals")
}

// ============================================
// PHOTO
// ============================================

/// Photo model - represents a photo uploaded by/for a client
model Photo {
  id           String    @id @default(cuid())
  clientId     String    @map("client_id")
  url          String
  uploadedById String    @map("uploaded_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  deletedAt    DateTime? @map("deleted_at")

  // Relations
  client     User @relation("PhotoClient", fields: [clientId], references: [id])
  uploadedBy User @relation("PhotoUploader", fields: [uploadedById], references: [id])

  // Indexes
  @@index([clientId])
  @@index([uploadedById])
  @@map("photos")
}

// ============================================
// CUSTOMER
// ============================================

/// Customer model - first-class barbershop customer identity.
///
/// Identity key is (barbershopId, phoneNormalized). Customers are NOT
/// global: a phone number may be linked to different customers in
/// different barbershops, but never to two different customers in the
/// same barbershop. Existing appointments retain their snapshot
/// fields (clientName, clientPhone, clientPhoneNormalized) for
/// historical truth; the current directory identity is in this row.
model Customer {
  id              String    @id @default(cuid())
  barbershopId    String    @map("barbershop_id")
  name            String
  phone           String
  phoneNormalized String    @map("phone_normalized")
  email           String?
  internalNotes   String?   @map("internal_notes") @db.VarChar(2000)
  firstSeenAt     DateTime  @map("first_seen_at")
  lastSeenAt      DateTime  @map("last_seen_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  // Relations
  barbershop   Barbershop    @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  appointments Appointment[] @relation("AppointmentCustomer")

  // Indexes
  @@unique([id, barbershopId])
  @@unique([barbershopId, phoneNormalized])
  @@index([barbershopId, name])
  @@index([barbershopId, lastSeenAt])
  @@map("customers")
}
