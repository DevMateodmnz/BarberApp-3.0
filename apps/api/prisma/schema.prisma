// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  OWNER
  BARBER
  CLIENT
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum DepositPolicyMode {
  DISABLED
  FIXED
  PERCENTAGE
}

enum PaymentProvider {
  MERCADO_PAGO
}

enum PaymentConnectionStatus {
  DISCONNECTED
  CONNECTING
  CONNECTED
  REFRESH_REQUIRED
  REVOKED
  ERROR
}

enum BookingPaymentPurpose {
  DEPOSIT
}

enum BookingPaymentStatus {
  CREATING
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
  REFUNDED
  REVIEW_REQUIRED
  ERROR
}

enum PaymentReviewStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum PaymentReviewReason {
  APPROVED_AFTER_HOLD_EXPIRY
  APPROVED_PAYMENT_ON_CANCELLED_APPOINTMENT
  AMOUNT_MISMATCH
  CURRENCY_MISMATCH
  SELLER_MISMATCH
  EXTERNAL_REFERENCE_MISMATCH
  PREFERENCE_MISMATCH
  DUPLICATE_PROVIDER_PAYMENT
  PROVIDER_RECONCILIATION_ERROR
  OTHER
}

enum PaymentReviewResolution {
  REFUNDED_EXTERNALLY
  NO_REFUND_REQUIRED
  CUSTOMER_CREDIT_GRANTED
  PAYMENT_ACCEPTED_MANUALLY
  DUPLICATE_RESOLVED
  OTHER
}

enum PaymentReviewActionType {
  OPENED
  MARKED_IN_PROGRESS
  NOTE_ADDED
  RESOLVED
  REOPENED
}

enum PaymentWebhookEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  REJECTED
  ERROR
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  OTHER
}

enum PromotionDiscountType {
  FIXED
  PERCENTAGE
}

enum PromotionServiceScope {
  ALL
  SELECTED
}

enum PromotionRedemptionStatus {
  RESERVED
  CONSUMED
  RELEASED
}

enum PromotionRedemptionReleaseReason {
  HOLD_EXPIRED
  PAYMENT_REJECTED
  PAYMENT_CANCELLED
  PUBLIC_CANCELLED
  PREFERENCE_CREATION_FAILED
}

enum LoyaltyLedgerEventType {
  STAMP_EARNED
  REWARD_ISSUED
  REWARD_REDEEMED
  REWARD_EXPIRED
  REWARD_REVOKED
  ADMIN_ADJUSTMENT
}

enum LoyaltyRewardStatus {
  AVAILABLE
  REDEEMED
  EXPIRED
  REVOKED
}

enum EmployeeInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
  DELIVERY_FAILED
}

enum EmployeeScheduleMode {
  INHERIT_BARBERSHOP
  CUSTOM
}

enum EmployeeScheduleExceptionType {
  FULL_DAY_OFF
  CUSTOM_HOURS
}

// Where a cancellation originated. Decoupled from UserRole because
// anonymous public bookings and automated (system) jobs have no
// UserRole identity. A row that was cancelled has at least one of
// (cancelledByRole, cancellationSource) populated, never both null.
enum AppointmentCancellationSource {
  STAFF
  AUTHENTICATED_CLIENT
  PUBLIC_BOOKING
  SYSTEM
}

enum AppointmentNotificationType {
  BOOKING_CONFIRMATION
  REMINDER_24H
  APPOINTMENT_RESCHEDULED
}

enum AppointmentChangeType {
  RESCHEDULED
}

enum AppointmentNotificationChannel {
  EMAIL
}

enum AppointmentNotificationStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

enum NotificationAttemptOutcome {
  SENT
  TEMPORARY_FAILURE
  PERMANENT_FAILURE
}

enum CommissionEntryType {
  ACCRUAL
  REVERSAL
}

enum CommissionLiquidationStatus {
  OPEN
  PAID
  VOIDED
}

// ============================================
// USER
// ============================================

/// User model - represents all authenticated users (owners, barbers, clients)
/// Each user is tied to a Clerk user via clerkUserId
model User {
  id          String    @id @default(cuid())
  clerkUserId String    @unique @map("clerk_user_id")
  email       String    @unique
  name        String?
  role        UserRole  @default(CLIENT)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  // Relations
  ownedBarbershops                      Barbershop[]                 @relation("BarbershopOwner")
  employees                             Employee[]
  clientAppointments                    Appointment[]                @relation("AppointmentClient")
  appointmentChanges                    AppointmentChange[]          @relation("AppointmentChangeActor")
  uploadedPhotos                        Photo[]                      @relation("PhotoUploader")
  clientPhotos                          Photo[]                      @relation("PhotoClient")
  sentInvitations                       EmployeeInvitation[]         @relation("EmployeeInvitationInvitedBy")
  acceptedInvitations                   EmployeeInvitation[]         @relation("EmployeeInvitationUser")
  manualRetriedAppointmentNotifications AppointmentNotification[]    @relation("AppointmentNotificationLastManualRetryBy")
  PaymentOAuthState                     PaymentOAuthState[]
  assignedPaymentReviews                BookingPaymentReview[]       @relation("BookingPaymentReviewAssignedTo")
  resolvedPaymentReviews                BookingPaymentReview[]       @relation("BookingPaymentReviewResolvedBy")
  paymentReviewActions                  BookingPaymentReviewAction[] @relation("BookingPaymentReviewActionActor")
  createdPromotions                     Promotion[]                  @relation("PromotionCreatedBy")
  updatedPromotions                     Promotion[]                  @relation("PromotionUpdatedBy")
  createdLoyaltyPrograms                BarbershopLoyaltyProgram[]   @relation("LoyaltyProgramCreatedBy")
  updatedLoyaltyPrograms                BarbershopLoyaltyProgram[]   @relation("LoyaltyProgramUpdatedBy")
  loyaltyLedgerEvents                   LoyaltyLedgerEvent[]         @relation("LoyaltyLedgerActor")
  createdCommissionLiquidations         CommissionLiquidation[]      @relation("CommissionLiquidationCreatedBy")
  paidCommissionLiquidations            CommissionLiquidation[]      @relation("CommissionLiquidationPaidBy")
  voidedCommissionLiquidations          CommissionLiquidation[]      @relation("CommissionLiquidationVoidedBy")

  @@map("users")
}

// ============================================
// BARBERSHOP
// ============================================

/// Barbershop model - represents a barbershop business
/// Each barbershop has exactly one owner
model Barbershop {
  id                           String    @id @default(cuid())
  ownerId                      String    @map("owner_id")
  name                         String
  address                      String?
  phone                        String?
  publicSlug                   String?   @unique @map("public_slug")
  timezone                     String    @default("America/Argentina/Tucuman")
  isActive                     Boolean   @default(true)
  createdAt                    DateTime  @default(now()) @map("created_at")
  updatedAt                    DateTime  @updatedAt @map("updated_at")
  deletedAt                    DateTime? @map("deleted_at")
  defaultCommissionBasisPoints Int       @default(0) @map("default_commission_basis_points")

  // Relations
  owner                           User                             @relation("BarbershopOwner", fields: [ownerId], references: [id])
  employees                       Employee[]
  services                        Service[]
  appointments                    Appointment[]
  customers                       Customer[]
  workingHours                    WorkingHours[]
  scheduleExceptions              BarbershopScheduleException[]
  employeeWorkingIntervals        EmployeeWorkingInterval[]
  employeeScheduleExceptions      EmployeeScheduleException[]
  publicBookingIdempotencyRecords PublicBookingIdempotency[]
  appointmentNotifications        AppointmentNotification[]
  appointmentNotificationAttempts AppointmentNotificationAttempt[]
  appointmentChanges              AppointmentChange[]
  serviceRecords                  ServiceRecord[]
  employeeInvitations             EmployeeInvitation[]
  depositPolicy                   BarbershopDepositPolicy?
  paymentConnections              BarbershopPaymentConnection[]
  paymentWebhookEvents            PaymentWebhookEvent[]
  bookingPayments                 BookingPayment[]
  PaymentOAuthState               PaymentOAuthState[]
  paymentReviews                  BookingPaymentReview[]
  paymentReviewActions            BookingPaymentReviewAction[]
  promotions                      Promotion[]
  promotionServices               PromotionService[]
  promotionRedemptions            PromotionRedemption[]
  promotionCustomerUsages         PromotionCustomerUsage[]
  loyaltyProgram                  BarbershopLoyaltyProgram?
  loyaltySummaries                CustomerLoyaltySummary[]
  loyaltyRewards                  LoyaltyReward[]
  loyaltyLedgerEvents             LoyaltyLedgerEvent[]
  commissionPolicies              EmployeeCommissionPolicy[]
  commissionEntries               CommissionEntry[]
  commissionLiquidations          CommissionLiquidation[]

  // Indexes
  @@index([ownerId])
  @@index([ownerId, isActive])
  @@map("barbershops")
}

// ============================================
// EMPLOYEE
// ============================================

/// Employee model - represents a barber/employee working at a barbershop
/// Links a User to a Barbershop
model Employee {
  id           String               @id @default(cuid())
  barbershopId String               @map("barbershop_id")
  userId       String               @map("user_id")
  isActive     Boolean              @default(true)
  scheduleMode EmployeeScheduleMode @default(INHERIT_BARBERSHOP) @map("schedule_mode")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  deletedAt    DateTime?            @map("deleted_at")

  // Relations
  barbershop             Barbershop                  @relation(fields: [barbershopId], references: [id])
  user                   User                        @relation(fields: [userId], references: [id])
  employeeServices       EmployeeService[]
  appointments           Appointment[]
  serviceRecords         ServiceRecord[]
  workingIntervals       EmployeeWorkingInterval[]
  scheduleExceptions     EmployeeScheduleException[]
  acceptedInvitations    EmployeeInvitation[]        @relation("EmployeeInvitationEmployee")
  commissionPolicy       EmployeeCommissionPolicy?
  commissionEntries      CommissionEntry[]
  commissionLiquidations CommissionLiquidation[]

  // Constraint: one employee record per user per barbershop
  @@unique([barbershopId, userId])
  @@unique([id, barbershopId])
  // Indexes
  @@index([barbershopId])
  @@index([userId])
  @@index([barbershopId, isActive])
  @@map("employees")
}

// ============================================
// EMPLOYEE SCHEDULE
// ============================================

/// EmployeeWorkingInterval model — one recurring custom interval per employee/day.
/// Current product scope supports at most one interval per weekday for custom employee schedules.
model EmployeeWorkingInterval {
  id           String   @id @default(cuid())
  barbershopId String   @map("barbershop_id")
  employeeId   String   @map("employee_id")
  dayOfWeek    Int      @map("day_of_week")
  openTime     String   @map("open_time")
  closeTime    String   @map("close_time")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  employee   Employee   @relation(fields: [employeeId, barbershopId], references: [id, barbershopId], onDelete: Cascade)
  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@unique([employeeId, dayOfWeek])
  @@index([employeeId])
  @@index([barbershopId, dayOfWeek])
  @@map("employee_working_intervals")
}

/// EmployeeScheduleException model — employee-specific local-date override.
model EmployeeScheduleException {
  id           String                        @id @default(cuid())
  barbershopId String                        @map("barbershop_id")
  employeeId   String                        @map("employee_id")
  localDate    String                        @map("local_date")
  type         EmployeeScheduleExceptionType
  reason       String?                       @db.VarChar(500)
  createdAt    DateTime                      @default(now()) @map("created_at")
  updatedAt    DateTime                      @updatedAt @map("updated_at")

  employee   Employee                            @relation(fields: [employeeId, barbershopId], references: [id, barbershopId], onDelete: Cascade)
  barbershop Barbershop                          @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  intervals  EmployeeScheduleExceptionInterval[]

  @@unique([employeeId, localDate])
  @@index([employeeId, localDate])
  @@index([barbershopId, localDate])
  @@map("employee_schedule_exceptions")
}

/// EmployeeScheduleExceptionInterval model — ordered custom intervals for one employee exception date.
model EmployeeScheduleExceptionInterval {
  id                  String   @id @default(cuid())
  scheduleExceptionId String   @map("schedule_exception_id")
  openTime            String   @map("open_time")
  closeTime           String   @map("close_time")
  position            Int
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  scheduleException EmployeeScheduleException @relation(fields: [scheduleExceptionId], references: [id], onDelete: Cascade, map: "employee_schedule_exception_intervals_schedule_exception_id_fke")

  @@unique([scheduleExceptionId, position], map: "employee_schedule_exception_intervals_schedule_exception_id_pos")
  @@index([scheduleExceptionId], map: "employee_schedule_exception_intervals_schedule_exception_id_idx")
  @@map("employee_schedule_exception_intervals")
}

// ============================================
// EMPLOYEE INVITATION
// ============================================

/// EmployeeInvitation model - tracks the invitation lifecycle for BARBER onboarding
model EmployeeInvitation {
  id                  String                   @id @default(cuid())
  barbershopId        String                   @map("barbershop_id")
  invitedByUserId     String                   @map("invited_by_user_id")
  emailNormalized     String                   @map("email_normalized")
  invitedRole         UserRole                 @default(BARBER) @map("invited_role")
  status              EmployeeInvitationStatus @default(PENDING)
  clerkInvitationId   String?                  @unique @map("clerk_invitation_id")
  expiresAt           DateTime?                @map("expires_at")
  lastSentAt          DateTime?                @map("last_sent_at")
  resendCount         Int                      @default(0) @map("resend_count")
  deliveryFailureCode String?                  @map("delivery_failure_code")
  acceptedAt          DateTime?                @map("accepted_at")
  revokedAt           DateTime?                @map("revoked_at")
  userId              String?                  @map("user_id")
  employeeId          String?                  @map("employee_id")
  createdAt           DateTime                 @default(now()) @map("created_at")
  updatedAt           DateTime                 @updatedAt @map("updated_at")

  // Relations
  barbershop    Barbershop @relation(fields: [barbershopId], references: [id])
  invitedByUser User       @relation("EmployeeInvitationInvitedBy", fields: [invitedByUserId], references: [id])
  user          User?      @relation("EmployeeInvitationUser", fields: [userId], references: [id], onDelete: SetNull)
  employee      Employee?  @relation("EmployeeInvitationEmployee", fields: [employeeId], references: [id], onDelete: SetNull)

  @@unique([barbershopId, emailNormalized])
  @@index([barbershopId])
  @@index([invitedByUserId])
  @@index([userId])
  @@index([employeeId])
  @@index([barbershopId, status])
  @@map("employee_invitations")
}

// ============================================
// SERVICE
// ============================================

/// Service model - represents a service offered by a barbershop
model Service {
  id              String    @id @default(cuid())
  barbershopId    String    @map("barbershop_id")
  name            String
  description     String?
  durationMinutes Int       @map("duration_minutes")
  priceCents      Int       @map("price_cents")
  currency        String    @default("ARS")
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  // Relations
  barbershop        Barbershop         @relation(fields: [barbershopId], references: [id])
  employeeServices  EmployeeService[]
  appointments      Appointment[]
  serviceRecords    ServiceRecord[]
  promotionServices PromotionService[]

  // Indexes
  @@unique([id, barbershopId])
  @@index([barbershopId])
  @@index([barbershopId, isActive])
  @@map("services")
}

// ============================================
// EMPLOYEE_SERVICE
// ============================================

/// EmployeeService model - junction table linking employees to services they can perform
model EmployeeService {
  id         String   @id @default(cuid())
  employeeId String   @map("employee_id")
  serviceId  String   @map("service_id")
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  employee Employee @relation(fields: [employeeId], references: [id])
  service  Service  @relation(fields: [serviceId], references: [id])

  // Constraint: unique employee + service pair
  @@unique([employeeId, serviceId])
  @@index([employeeId])
  @@index([serviceId])
  @@map("employee_services")
}

// ============================================
// APPOINTMENT
// ============================================

/// Appointment model - represents a booked appointment
model Appointment {
  id                      String                         @id @default(cuid())
  barbershopId            String                         @map("barbershop_id")
  employeeId              String                         @map("employee_id")
  clientId                String?                        @map("client_id")
  serviceId               String                         @map("service_id")
  clientName              String                         @map("client_name")
  clientPhone             String?                        @map("client_phone")
  clientEmail             String?                        @map("client_email")
  customerId              String?                        @map("customer_id")
  publicReference         String?                        @unique @map("public_reference")
  publicConsentAcceptedAt DateTime?                      @map("public_consent_accepted_at")
  publicConsentVersion    String?                        @map("public_consent_version")
  serviceName             String                         @map("service_name")
  servicePriceCents       Int                            @map("service_price_cents")
  discountCents           Int                            @default(0) @map("discount_cents")
  finalPriceCents         Int                            @default(0) @map("final_price_cents")
  serviceDurationMinutes  Int                            @map("service_duration_minutes")
  serviceCurrency         String                         @map("service_currency")
  startAt                 DateTime                       @map("start_at")
  endAt                   DateTime                       @map("end_at")
  status                  AppointmentStatus              @default(PENDING)
  paymentHoldExpiresAt    DateTime?                      @map("payment_hold_expires_at")
  paymentConfirmedAt      DateTime?                      @map("payment_confirmed_at")
  notes                   String?
  // Lifecycle tracking — Phase 1 no-show prevention foundation.
  // All fields are nullable so existing rows remain valid and the migration
  // is purely additive. Timestamps are stamped in the barbershop's UTC instant
  // by the service layer; cancelledByRole records the role of the actor.
  startedAt               DateTime?                      @map("started_at")
  confirmedAt             DateTime?                      @map("confirmed_at")
  completedAt             DateTime?                      @map("completed_at")
  cancelledAt             DateTime?                      @map("cancelled_at")
  noShowAt                DateTime?                      @map("no_show_at")
  cancelledByRole         UserRole?                      @map("cancelled_by_role")
  cancellationSource      AppointmentCancellationSource? @map("cancellation_source")
  cancelReason            String?                        @map("cancel_reason") @db.VarChar(500)
  // Normalized E.164 client phone, populated by the service for new
  // bookings. Legacy rows remain NULL; the customer lookup endpoint
  // only matches when the normalized value is present.
  clientPhoneNormalized   String?                        @map("client_phone_normalized") @db.VarChar(20)
  createdAt               DateTime                       @default(now()) @map("created_at")
  updatedAt               DateTime                       @updatedAt @map("updated_at")
  deletedAt               DateTime?                      @map("deleted_at")

  // Relations
  barbershop                      Barbershop                 @relation(fields: [barbershopId], references: [id])
  employee                        Employee                   @relation(fields: [employeeId], references: [id])
  client                          User?                      @relation("AppointmentClient", fields: [clientId], references: [id])
  customer                        Customer?                  @relation("AppointmentCustomer", fields: [customerId, barbershopId], references: [id, barbershopId], onDelete: Restrict)
  service                         Service                    @relation(fields: [serviceId], references: [id])
  publicBookingIdempotencyRecords PublicBookingIdempotency[]
  notifications                   AppointmentNotification[]
  changes                         AppointmentChange[]
  serviceRecords                  ServiceRecord[]
  bookingPayments                 BookingPayment[]
  promotionRedemption             PromotionRedemption?
  loyaltyLedgerEvents             LoyaltyLedgerEvent[]
  redeemedLoyaltyRewards          LoyaltyReward[]            @relation("LoyaltyRewardRedemptionAppointment")
  sourceIssuedLoyaltyRewards      LoyaltyReward[]            @relation("LoyaltyRewardSourceAppointment")
  commissionEntries               CommissionEntry[]

  @@unique([id, barbershopId])
  // Indexes for common queries
  @@index([barbershopId])
  @@index([employeeId])
  @@index([clientId])
  @@index([customerId])
  @@index([customerId, barbershopId])
  @@index([startAt])
  @@index([barbershopId, employeeId, startAt])
  @@index([employeeId, startAt, status])
  @@index([barbershopId, clientPhoneNormalized])
  @@index([paymentHoldExpiresAt])
  @@map("appointments")
}

model EmployeeCommissionPolicy {
  id                    String   @id @default(cuid())
  barbershopId          String   @map("barbershop_id")
  employeeId            String   @unique @map("employee_id")
  percentageBasisPoints Int      @map("percentage_basis_points")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Restrict)
  employee   Employee   @relation(fields: [employeeId, barbershopId], references: [id, barbershopId], onDelete: Restrict)

  @@unique([employeeId, barbershopId])
  @@index([barbershopId])
  @@map("employee_commission_policies")
}

model CommissionEntry {
  id                    String              @id @default(cuid())
  barbershopId          String              @map("barbershop_id")
  employeeId            String              @map("employee_id")
  appointmentId         String              @map("appointment_id")
  type                  CommissionEntryType @default(ACCRUAL)
  grossAmountCents      Int                 @map("gross_amount_cents")
  percentageBasisPoints Int                 @map("percentage_basis_points")
  commissionAmountCents Int                 @map("commission_amount_cents")
  currency              String
  earnedAt              DateTime            @map("earned_at")
  liquidationId         String?             @map("liquidation_id")
  reversalOfId          String?             @unique @map("reversal_of_id")
  reason                String?             @db.VarChar(500)
  createdAt             DateTime            @default(now()) @map("created_at")

  barbershop  Barbershop             @relation(fields: [barbershopId], references: [id], onDelete: Restrict)
  employee    Employee               @relation(fields: [employeeId, barbershopId], references: [id, barbershopId], onDelete: Restrict)
  appointment Appointment            @relation(fields: [appointmentId, barbershopId], references: [id, barbershopId], onDelete: Restrict)
  liquidation CommissionLiquidation? @relation(fields: [liquidationId, barbershopId], references: [id, barbershopId], onDelete: Restrict)
  reversalOf  CommissionEntry?       @relation("CommissionEntryReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversal    CommissionEntry?       @relation("CommissionEntryReversal")

  @@index([appointmentId])
  @@index([barbershopId, employeeId, earnedAt])
  @@index([barbershopId, employeeId, liquidationId, earnedAt])
  @@index([liquidationId])
  @@map("commission_entries")
}

model CommissionLiquidation {
  id                    String                      @id @default(cuid())
  barbershopId          String                      @map("barbershop_id")
  employeeId            String                      @map("employee_id")
  status                CommissionLiquidationStatus @default(OPEN)
  periodStart           DateTime                    @map("period_start")
  periodEnd             DateTime                    @map("period_end")
  grossAmountCents      Int                         @map("gross_amount_cents")
  commissionAmountCents Int                         @map("commission_amount_cents")
  currency              String
  entryCount            Int                         @map("entry_count")
  idempotencyKey        String                      @map("idempotency_key") @db.VarChar(100)
  createdByUserId       String                      @map("created_by_user_id")
  paidByUserId          String?                     @map("paid_by_user_id")
  paidAt                DateTime?                   @map("paid_at")
  voidedByUserId        String?                     @map("voided_by_user_id")
  voidedAt              DateTime?                   @map("voided_at")
  voidReason            String?                     @map("void_reason") @db.VarChar(500)
  createdAt             DateTime                    @default(now()) @map("created_at")
  updatedAt             DateTime                    @updatedAt @map("updated_at")

  barbershop Barbershop        @relation(fields: [barbershopId], references: [id], onDelete: Restrict)
  employee   Employee          @relation(fields: [employeeId, barbershopId], references: [id, barbershopId], onDelete: Restrict)
  createdBy  User              @relation("CommissionLiquidationCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  paidBy     User?             @relation("CommissionLiquidationPaidBy", fields: [paidByUserId], references: [id], onDelete: Restrict)
  voidedBy   User?             @relation("CommissionLiquidationVoidedBy", fields: [voidedByUserId], references: [id], onDelete: Restrict)
  entries    CommissionEntry[]

  @@unique([barbershopId, idempotencyKey])
  @@unique([id, barbershopId])
  @@index([barbershopId, employeeId, createdAt])
  @@index([barbershopId, status, createdAt])
  @@map("commission_liquidations")
}

model BarbershopDepositPolicy {
  id                    String            @id @default(cuid())
  barbershopId          String            @unique @map("barbershop_id")
  mode                  DepositPolicyMode @default(DISABLED)
  fixedAmountCents      Int?              @map("fixed_amount_cents")
  percentageBasisPoints Int?              @map("percentage_basis_points")
  holdDurationMinutes   Int               @default(15) @map("hold_duration_minutes")
  currency              String            @default("ARS")
  publicTerms           String?           @map("public_terms") @db.VarChar(1000)
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")

  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@map("barbershop_deposit_policies")
}

model BarbershopPaymentConnection {
  id                     String                  @id @default(cuid())
  barbershopId           String                  @map("barbershop_id")
  provider               PaymentProvider
  status                 PaymentConnectionStatus @default(DISCONNECTED)
