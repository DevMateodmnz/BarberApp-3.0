  barbershop  Barbershop   @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@unique([barbershopId, operation, idempotencyKey], map: "public_booking_idempotency_barbershop_id_operation_idempotency_")
  @@index([barbershopId])
  @@index([appointmentId])
  @@index([expiresAt])
  @@map("public_booking_idempotency")
}

// ============================================
// SERVICE RECORD
// ============================================

/// ServiceRecord model - represents a completed service/cut performed by a barber
/// Supports walk-in customers (no appointment required) and future appointment-linked records
model ServiceRecord {
  id            String         @id @default(cuid())
  barbershopId  String         @map("barbershop_id")
  employeeId    String         @map("employee_id")
  serviceId     String         @map("service_id")
  appointmentId String?        @map("appointment_id")
  clientName    String?        @map("client_name")
  priceCents    Int            @map("price_cents")
  paymentMethod PaymentMethod? @map("payment_method")
  notes         String?
  performedAt   DateTime       @default(now()) @map("performed_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  deletedAt     DateTime?      @map("deleted_at")

  // Relations
  barbershop  Barbershop   @relation(fields: [barbershopId], references: [id])
  employee    Employee     @relation(fields: [employeeId], references: [id])
  service     Service      @relation(fields: [serviceId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])

  // Indexes
  @@index([barbershopId])
  @@index([employeeId])
  @@index([serviceId])
  @@index([barbershopId, performedAt])
  @@index([employeeId, performedAt])
  @@map("service_records")
}

// ============================================
// WORKING HOURS
// ============================================

/// WorkingHours model — per-barbershop per-day-of-week schedule
/// dayOfWeek: 0=Sunday, 1=Monday, ..., 6=Saturday
/// openTime/closeTime in "HH:mm" 24h format in the barbershop's local timezone
/// Absence of a row for a given dayOfWeek means the shop is closed that day
model WorkingHours {
  id           String   @id @default(cuid())
  barbershopId String   @map("barbershop_id")
  dayOfWeek    Int      @map("day_of_week")
  openTime     String   @map("open_time")
  closeTime    String   @map("close_time")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  barbershop Barbershop @relation(fields: [barbershopId], references: [id])

  // Constraint: one schedule per barbershop per day
  @@unique([barbershopId, dayOfWeek])
  @@index([barbershopId])
  @@map("working_hours")
}

// ============================================
// BARBERSHOP SCHEDULE EXCEPTIONS
// ============================================

/// BarbershopScheduleException model — date-specific weekly-hours override
/// localDate is stored as a strict YYYY-MM-DD string in the barbershop's local timezone
model BarbershopScheduleException {
  id           String   @id @default(cuid())
  barbershopId String   @map("barbershop_id")
  localDate    String   @map("local_date")
  isClosed     Boolean  @default(false) @map("is_closed")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  barbershop Barbershop                            @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  intervals  BarbershopScheduleExceptionInterval[]

  @@unique([barbershopId, localDate])
  @@index([barbershopId])
  @@map("barbershop_schedule_exceptions")
}

/// BarbershopScheduleExceptionInterval model — ordered custom intervals for one exception date
model BarbershopScheduleExceptionInterval {
  id                  String   @id @default(cuid())
  scheduleExceptionId String   @map("schedule_exception_id")
  openTime            String   @map("open_time")
  closeTime           String   @map("close_time")
  position            Int
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  // Relations
  scheduleException BarbershopScheduleException @relation(fields: [scheduleExceptionId], references: [id], onDelete: Cascade, map: "barbershop_schedule_exception_intervals_schedule_exception_id_f")

  @@unique([scheduleExceptionId, position], map: "barbershop_schedule_exception_intervals_schedule_exception_id_p")
  @@index([scheduleExceptionId], map: "barbershop_schedule_exception_intervals_schedule_exception_id_i")
  @@map("barbershop_schedule_exception_intervals")
}

// ============================================
// PHOTO
// ============================================

/// Photo model - represents a photo uploaded by/for a client
model Photo {
  id           String    @id @default(cuid())
  clientId     String    @map("client_id")
  url          String
  uploadedById String    @map("uploaded_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  deletedAt    DateTime? @map("deleted_at")

  // Relations
  client     User @relation("PhotoClient", fields: [clientId], references: [id])
  uploadedBy User @relation("PhotoUploader", fields: [uploadedById], references: [id])

  // Indexes
  @@index([clientId])
  @@index([uploadedById])
  @@map("photos")
}

// ============================================
// CUSTOMER
// ============================================

/// Customer model - first-class barbershop customer identity.
///
/// Identity key is (barbershopId, phoneNormalized). Customers are NOT
/// global: a phone number may be linked to different customers in
/// different barbershops, but never to two different customers in the
/// same barbershop. Existing appointments retain their snapshot
/// fields (clientName, clientPhone, clientPhoneNormalized) for
/// historical truth; the current directory identity is in this row.
model Customer {
  id              String    @id @default(cuid())
  barbershopId    String    @map("barbershop_id")
  name            String
  phone           String
  phoneNormalized String    @map("phone_normalized")
  email           String?
  internalNotes   String?   @map("internal_notes") @db.VarChar(2000)
  firstSeenAt     DateTime  @map("first_seen_at")
  lastSeenAt      DateTime  @map("last_seen_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  // Relations
  barbershop              Barbershop               @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  appointments            Appointment[]            @relation("AppointmentCustomer")
  promotionRedemptions    PromotionRedemption[]
  promotionCustomerUsages PromotionCustomerUsage[]
  loyaltySummary          CustomerLoyaltySummary?
  loyaltyRewards          LoyaltyReward[]
  loyaltyLedgerEvents     LoyaltyLedgerEvent[]

  // Indexes
  @@unique([id, barbershopId])
  @@unique([barbershopId, phoneNormalized])
  @@index([barbershopId, name])
  @@index([barbershopId, lastSeenAt])
  @@map("customers")
}
