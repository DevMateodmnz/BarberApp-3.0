# BarberApp API - Test Environment
# Used for running database tests

# Database - uses separate test database
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/barberapp_test
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5433/barberapp_test

# Clerk - use test keys/placeholders
CLERK_SECRET_KEY=sk_test_mock
CLERK_WEBHOOK_SECRET=whsec_test_mock

# Server
PORT=3001
NODE_ENV=test

# Optional - explicit test overrides
# RATE_LIMIT_ENABLED=false
