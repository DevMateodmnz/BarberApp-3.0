# BarberApp API - Local Development Environment
# Copy this file to .env and replace placeholders as needed.
# This file is for non-production use only.

# Required - local database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/barberapp

# Required - Clerk backend
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_WEBHOOK_SECRET=whsec_replace_me

# Optional - explicit browser allowlist for credentialed CORS.
# Leave unset unless a real browser client must call the Express API directly.
# Requests without an Origin header (native mobile, webhooks, BFF/server-to-server)
# continue to work when this is unset.
# CORS_ALLOWED_ORIGINS=http://localhost:8081,http://192.168.1.50:8081

# Optional - server/runtime
PORT=3000
NODE_ENV=development

# Optional - rate limiting overrides
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=100
