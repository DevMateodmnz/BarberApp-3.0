# BarberApp API - Local Development Environment
# Copy this file to .env and replace placeholders as needed.
# This file is for non-production use only.

# Required - local database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/barberapp

# Required - Clerk backend
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_WEBHOOK_SECRET=whsec_replace_me

# Optional - explicit browser allowlist for credentialed CORS in development.
# If omitted outside production, the API will echo valid request origins
# dynamically and still allow requests with no Origin header.
# ALLOWED_ORIGIN=http://localhost:8081,http://192.168.1.50:8081

# Optional - server/runtime
PORT=3000
NODE_ENV=development

# Optional - rate limiting overrides
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=100
