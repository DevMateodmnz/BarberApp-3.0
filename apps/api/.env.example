# BarberApp API — local development (never commit real credentials)

# CORE REQUIRED
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/barberapp
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_WEBHOOK_SECRET=whsec_replace_me
# Optional Clerk invitation landing URL.
# CLERK_INVITATION_REDIRECT_URL=http://localhost:8081

# OPTIONAL API RUNTIME
PORT=3000
# CORS_ALLOWED_ORIGINS=http://localhost:8081,http://192.168.1.50:8081
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=100

# NOTIFICATION WORKER (required when running notifications:worker)
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=turnos@example.invalid
# SMTP_FROM_NAME=BarberApp
# PUBLIC_WEB_BASE_URL=http://localhost:3001
# NOTIFICATION_WORKER_BATCH_SIZE=10
# NOTIFICATION_WORKER_POLL_INTERVAL_MS=30000
# NOTIFICATION_STALE_LOCK_MS=600000

# PAYMENTS — globally disabled by default
PAYMENTS_ENABLED=false

# Required only when PAYMENTS_ENABLED=true. Never reuse production values locally.
# PAYMENT_CREDENTIAL_ENCRYPTION_KEY=base64_encoded_32_byte_key
# PUBLIC_WEB_BASE_URL=http://localhost:3001
# PAYMENT_WEBHOOK_PUBLIC_URL=http://localhost:3000/api/v1/webhooks/mercado-pago
# MERCADO_PAGO_CLIENT_ID=replace_me
# MERCADO_PAGO_CLIENT_SECRET=replace_me
# MERCADO_PAGO_REDIRECT_URI=http://localhost:3000/api/v1/payments/mercado-pago/oauth/callback
# MERCADO_PAGO_WEBHOOK_SECRET=replace_me
# MERCADO_PAGO_API_BASE_URL=https://api.mercadopago.com
# MERCADO_PAGO_AUTHORIZATION_BASE_URL=https://auth.mercadopago.com
# MERCADO_PAGO_OAUTH_SCOPE=offline_access read write
# PAYMENT_WEBHOOK_WORKER_POLL_INTERVAL_MS=10000
# PAYMENT_EXPIRE_HOLDS_POLL_INTERVAL_MS=30000

# DEVELOPMENT-ONLY physical QA values are generated by `npm run qa:physical:configure`.
# Do not hand-copy them into preview or production environments.
