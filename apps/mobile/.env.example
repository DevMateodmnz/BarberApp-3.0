# BarberApp Mobile — Environment Variables
# Copy this file to .env.local and fill in real values.

# Clerk publishable key (required for auth)
# Get this from your Clerk Dashboard → API Keys
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here

# Backend API base URL (required for API calls)
# Leave as localhost for development with the local API server
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1