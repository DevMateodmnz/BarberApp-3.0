# BarberApp Mobile — Environment Variables
# Copy this file to .env.local for local Expo Go development only.
# Preview and production values should come from EAS environment variables instead.

# Build-time app environment label.
# Omit this locally to use the explicit development default.
# EXPO_PUBLIC_APP_ENV=development

# Clerk publishable key (required for all environments).
# Publishable keys are client-visible and safe to ship in the bundle.
# Never place CLERK_SECRET_KEY or webhook secrets in mobile env files.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here

# Backend API base URL.
# If omitted in local development, the app falls back to http://localhost:3000/api/v1.
# Set this explicitly when testing on an emulator, a LAN device, or any remote API.
# EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# Development-only physical QA identity. These values are tool-generated by
# `npm run qa:physical:configure`; never set them for preview/production builds.
# EXPO_PUBLIC_PHYSICAL_QA_MODE=true
# EXPO_PUBLIC_PHYSICAL_QA_TRACE=true
# EXPO_PUBLIC_QA_RUNTIME_ID=32_lowercase_hex_characters
# EXPO_PUBLIC_QA_RUNTIME_FINGERPRINT=8_UPPERCASE_HEX
# EXPO_PUBLIC_QA_RUNTIME_HEAD=40_lowercase_git_hash
# EXPO_PUBLIC_QA_RUNTIME_STARTED_AT=2026-01-01T00:00:00.000Z
